{
  "$defs": {
    "Entity": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Entity",
      "type": "object"
    }
  },
  "properties": {
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "group": {
      "items": {
        "type": "string"
      },
      "title": "Group",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "matched_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Matched Event Ids",
      "type": "array"
    },
    "rule_id": {
      "title": "Rule Id",
      "type": "string"
    },
    "rule_name": {
      "title": "Rule Name",
      "type": "string"
    },
    "rule_version": {
      "title": "Rule Version",
      "type": "integer"
    },
    "runbook": {
      "items": {
        "type": "string"
      },
      "title": "Runbook",
      "type": "array"
    },
    "schema_version": {
      "default": "signalforge.finding.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "tactics": {
      "items": {
        "type": "string"
      },
      "title": "Tactics",
      "type": "array"
    },
    "techniques": {
      "items": {
        "type": "string"
      },
      "title": "Techniques",
      "type": "array"
    }
  },
  "required": [
    "id",
    "rule_id",
    "rule_version",
    "rule_name",
    "severity",
    "first_seen",
    "last_seen",
    "detected_at",
    "group",
    "matched_event_ids",
    "evidence",
    "entities",
    "tactics",
    "techniques",
    "runbook"
  ],
  "title": "Finding",
  "type": "object"
}
